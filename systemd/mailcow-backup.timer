[Unit]
Description=Daily mailcow backup timer
Documentation=https://github.com/Paul1404/mailcow-cold-standby
Requires=mailcow-backup.service

[Timer]
# Run daily at 3:00 AM
OnCalendar=*-*-* 03:00:00

# Do NOT run a catch-up backup if the scheduled time was missed. A host that
# reboots shortly after the scheduled time (e.g. weekly kernel-update reboots)
# would otherwise trigger a second "catch-up" backup on top of the scheduled
# one. The script also enforces a once-per-day guard as a second safeguard.
Persistent=false

# Add random delay to prevent exact-time load spikes
RandomizedDelaySec=15min

# Accuracy (how close to the scheduled time)
AccuracySec=1min

# Specify which service to trigger
Unit=mailcow-backup.service

[Install]
WantedBy=timers.target
